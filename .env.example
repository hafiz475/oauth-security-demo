# ---------------------------------------------------------------------------
# oauth-security-demo configuration. `pnpm dev` copies this file to .env on
# first run and fills DEMO_AES_KEY with a freshly generated key.
# ---------------------------------------------------------------------------

# REQUIRED. 32 bytes as 64 hex characters. The backend refuses to boot without it.
# Generate one with: openssl rand -hex 32
DEMO_AES_KEY=

# Port the backend listens on.
PORT=3000

# Origin that serves the React app. In dev, Vite proxies API calls so the
# browser only ever talks to this origin.
APP_ORIGIN=http://localhost:5173

# Browser-visible origin of the backend (used to build redirect_uri values and
# as the expected origin of popup completion messages). Defaults to APP_ORIGIN.
# API_PUBLIC_ORIGIN=http://localhost:5173

# Comma-separated postMessage allow-list for WhatsApp Embedded Signup events.
# Defaults to APP_ORIGIN, http://localhost:PORT and https://www.facebook.com.
# ORIGIN_ALLOWLIST=http://localhost:5173,http://localhost:3000,https://www.facebook.com

# SQLite file, relative to packages/backend. Created on first boot.
DB_PATH=./data/demo.sqlite

# Log level: debug | info | warn | error | silent
LOG_LEVEL=info

# Mock identity provider. The browser reaches it through the public base; the
# backend exchanges codes through the internal base.
# MOCK_IDP_PUBLIC_BASE=http://localhost:5173/mock-oauth
# MOCK_IDP_INTERNAL_BASE=http://127.0.0.1:3000/mock-oauth
# META_GRAPH_BASE=http://127.0.0.1:3000/mock-oauth/graph

# Per-provider overrides for a real deployment. <ID> is the provider id upper-cased
# with dashes as underscores, e.g. GOOGLE_SHEETS, FACEBOOK_LEAD_ADS, INSTAGRAM.
# OAUTH_<ID>_AUTH_URL=
# OAUTH_<ID>_TOKEN_URL=
# OAUTH_<ID>_CLIENT_ID=
# OAUTH_<ID>_CLIENT_SECRET=
# OAUTH_WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=

# Frontend (read by Vite). Leave empty in dev to use the proxy.
# VITE_API_BASE=
# Grace period in ms before an uncompleted popup is marked abandoned when focus returns to the app (default: 1500).
# VITE_POPUP_ABANDON_MS=1500
